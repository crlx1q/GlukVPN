[Unit]
Description=GlukVPN SMTP and common BitTorrent egress safeguards
After=network-pre.target
Before=glukvpn-singbox.service vpn-node-agent.service
Wants=network-pre.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/vpn-node-agent/agent.env
ExecStart=/usr/local/sbin/glukvpn-egress-guard
RemainAfterExit=yes
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target

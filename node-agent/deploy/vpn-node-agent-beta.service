# GlukVPN node agent — BETA channel
#
# Install to /etc/systemd/system/vpn-node-agent-beta.service
#
# This is the same binary as the production agent, pointed at a different
# control plane (beta-api.gluk.tech), a different WireGuard interface (wg1,
# UDP 51821, 10.9.0.0/24) and a different state directory. Running both units
# on one host is safe: they never share an interface, a port, a subnet, an env
# file or a node credential.
#
# Privileges: unprivileged "vpnagent" user + CAP_NET_ADMIN only, exactly like
# the prod unit. It is NOT root and can only write /etc/vpn-node-agent-beta
# (needed to persist a rotated node token).

[Unit]
Description=GlukVPN node agent — BETA (WireGuard peer management + heartbeat)
Documentation=file:/opt/vpn-node-agent-beta/README.md
After=network-online.target wg-quick@wg1.service
Wants=network-online.target wg-quick@wg1.service

[Service]
Type=simple
User=vpnagent
Group=vpnagent
WorkingDirectory=/opt/vpn-node-agent-beta
Environment=NODE_ENV=production
Environment=ENV_FILE=/etc/vpn-node-agent-beta/agent.env
ExecStart=/usr/bin/node /opt/vpn-node-agent-beta/dist/agent.js

Restart=always
RestartSec=10
# Exit code 78 (EX_CONFIG) = broken config or revoked credential.
# Do not restart in a loop; fix the problem and start the unit again.
RestartPreventExitStatus=78

# ---------------------------- hardening -------------------------------------
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/etc/vpn-node-agent-beta

# ---------------------------- logging ---------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vpn-node-agent-beta

[Install]
WantedBy=multi-user.target

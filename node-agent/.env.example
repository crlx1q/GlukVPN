# ============================================================================
# GlukVPN node agent — environment template
# On the node this lives at /etc/vpn-node-agent/agent.env  (root:root, chmod 600)
# The node token is written here by the enroll script. NEVER commit real values.
# ============================================================================

# Control plane HTTPS endpoint (no trailing slash)
CONTROL_API_URL=https://api.gluk.tech

# Human-readable node identity, used at enrollment time
NODE_NAME=de-01
NODE_COUNTRY=Germany
NODE_COUNTRY_CODE=DE
# Public IPv4 of THIS node. Leave empty to auto-detect at enrollment.
NODE_PUBLIC_IP=
# Hostname clients will use as the WireGuard endpoint (IP is fine for a test)
NODE_HOSTNAME=

# One-time enrollment token issued by the control server CLI.
# Used exactly once, then this variable can be cleared.
NODE_ENROLLMENT_TOKEN=

# Filled in automatically by `npm run enroll` — do not edit by hand.
NODE_ID=
NODE_TOKEN=

# --------------------------- WireGuard --------------------------------------
WG_INTERFACE=wg0
WG_LISTEN_PORT=51820
# Server-side address of the tunnel interface (gateway for VPN clients)
WG_ADDRESS=10.8.0.1/24
WG_SUBNET=10.8.0.0/24
WG_MTU=1420
# Uplink interface used for NAT. Leave empty to auto-detect the default route.
WG_EGRESS_INTERFACE=

# --------------------------- timings ----------------------------------------
HEARTBEAT_INTERVAL_SEC=10
COMMAND_POLL_INTERVAL_SEC=3
STATS_REPORT_INTERVAL_SEC=30
HTTP_TIMEOUT_MS=15000

LOG_LEVEL=info
AGENT_VERSION=0.1.0

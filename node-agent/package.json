{
  "name": "@glukvpn/node-agent",
  "version": "0.1.0",
  "private": true,
  "description": "GlukVPN node agent: enrollment, heartbeat, metrics and WireGuard peer management over HTTPS (pull model)",
  "main": "dist/agent.js",
  "scripts": {
    "dev": "tsx watch src/agent.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/agent.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests && bash deploy/test-egress-guard.sh && node ../glukvpn-extension-1.5.0/server/glukvpn-browser-proxy/test-live-revocation.js",
    "enroll": "node dist/scripts/enroll.js",
    "enroll:dev": "tsx src/scripts/enroll.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}

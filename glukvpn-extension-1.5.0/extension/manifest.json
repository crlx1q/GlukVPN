{
	"manifest_version": 3,
	"name": "GlukVPN",
	"short_name": "GlukVPN",
	"version": "1.2.0",
	"description": "GlukVPN for the browser: sign in and route browser traffic through your GlukVPN node.",
	"minimum_chrome_version": "108",
	"icons": {
		"16": "icons/on/icon16.png",
		"32": "icons/on/icon32.png",
		"48": "icons/on/icon48.png",
		"128": "icons/on/icon128.png"
	},
	"action": {
		"default_title": "GlukVPN",
		"default_popup": "ui/popup.html",
		"default_icon": {
			"16": "icons/off/icon16.png",
			"32": "icons/off/icon32.png",
			"48": "icons/off/icon48.png",
			"128": "icons/off/icon128.png"
		}
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"incognito": "spanning",
	"permissions": [
		"proxy",
		"storage",
		"alarms",
		"webRequest",
		"webRequestAuthProvider",
		"notifications"
	],
	"host_permissions": [
		"<all_urls>"
	]
}
[Unit]
Description=GlukVPN browser gateway (TLS CONNECT proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=glukproxy
Group=glukproxy
WorkingDirectory=/opt/glukvpn-browser-proxy
EnvironmentFile=/opt/glukvpn-browser-proxy/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3

# Needs to read the certbot private key
SupplementaryGroups=ssl-cert
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/letsencrypt
CapabilityBoundingSet=
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

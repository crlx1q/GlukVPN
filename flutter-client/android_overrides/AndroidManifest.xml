<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talk to the control plane over HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The WireGuard tunnel is owned by a foreground service so Android does not
      kill it while the screen is off. The system VPN permission dialog itself is
      requested at runtime by VpnService.prepare() inside the plugin: it is NOT a
      manifest permission and must stay visible to the user.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 13+: needed for the persistent "VPN is on" notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      enableOnBackInvokedCallback opts the app into the predictive back gesture
      (Android 13+, mandatory behaviour on Android 16). Without it the platform
      keeps the legacy path and a back press on the first route finishes the
      activity outright, which is why Servers -> Back used to close GlukVPN.
      With it, Flutter's PopScope decides: the tab shell walks back to Home and
      only the Home tab actually leaves the app.
    -->
    <application
        android:label="GlukVPN"
        android:name="${applicationName}"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>

# ---------------------------------------------------------------------------
# Dart / Flutter build output
# ---------------------------------------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
build/
*.iml
.idea/
.vscode/
*.log

# ---------------------------------------------------------------------------
# Generated platform scaffolding (on purpose NOT committed)
#
# android/ is regenerated by `flutter create --platforms=android` locally and in
# CI, so the Gradle / AGP / Kotlin versions always match the Flutter SDK that is
# actually building the APK. Everything we own lives in android_overrides/ and
# is copied on top of the generated scaffold. See README.md.
# ---------------------------------------------------------------------------
/android/
/ios/
/linux/
/macos/
/windows/
/web/

# ---------------------------------------------------------------------------
# Secrets: keystores, signing config, tokens, WireGuard keys
# Nothing here may ever be committed.
# ---------------------------------------------------------------------------
*.jks
*.keystore
key.properties
.env
.env.*
!.env.example

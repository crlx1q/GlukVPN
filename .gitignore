# ============================================================
# GlukVPN — secrets must NEVER be committed
# ============================================================
.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.p12
*.jks
*.keystore
key.properties
android-keystore-credentials.json
*-credentials.json
node-secret*
node_secret*
wg0.conf
wg-*.conf
privatekey
publickey

# ---- Node / TypeScript ----
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Prisma ----
control-server/prisma/*.db
control-server/prisma/*.db-journal

# ---- Flutter / Android ----
flutter-client/.dart_tool/
flutter-client/.flutter-plugins
flutter-client/.flutter-plugins-dependencies
flutter-client/.packages
flutter-client/build/
flutter-client/android/.gradle/
flutter-client/android/local.properties
flutter-client/android/app/release/
flutter-client/ios/Pods/
*.apk
*.aab
*.jks.base64
flutter-client/.metadata

# ---- OS / editors ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Runtime ----
logs/
*.log
tmp/

# ---- Local reference material / downloads (not part of the product) ----
# These sit in the repo root on the dev machine only. If any of them is still
# tracked, drop it from the index without deleting it from disk:
#   git rm -r --cached wg.msi wg-extracted2 browser-proxy.tar.gz logo.png
wg.msi
wg-extracted2/
browser-proxy.tar.gz
/logo.png

# glukvpn-extension-1.5.0/ used to be ignored here. That was a mistake: the
# browser extension is a shipped client, not reference material. Ignoring it
# hid it from repo-wide search, which is why the duplicated "linked to your
# account" banner survived several rounds of cleanup - the file could not be
# found, only guessed at.

# ---- Desktop build output ----
dist/stage/
GlukVPN-Setup-*.exe
# Archives are build output, never sources. A committed zip is a second copy of
# files that already live in the tree, and it starts rotting the moment those
# files change - while still looking authoritative to whoever downloads it.
*.zip
*.ico.bak
pubspec.android.bak

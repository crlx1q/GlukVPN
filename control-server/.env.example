# ============================================================================
# GlukVPN control server — environment template
# Copy to .env on the server ONLY:  cp .env.example .env && chmod 600 .env
# .env is git-ignored. Never commit real values.
# ============================================================================

NODE_ENV=production
# Bind to loopback only: aaPanel Nginx terminates TLS and proxies to this port.
HOST=127.0.0.1
PORT=8081
LOG_LEVEL=info

# Public HTTPS base URL (used by the node agent and the Flutter client)
PUBLIC_API_URL=https://api.gluk.tech

# --------------------------- database ---------------------------------------
# PostgreSQL listens on 127.0.0.1 only. Generate the password with:
#   openssl rand -base64 24
DATABASE_URL=postgresql://glukvpn:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:5432/glukvpn?schema=public

# --------------------------- crypto secrets ---------------------------------
# JWT signing secret:            openssl rand -base64 48
JWT_SECRET=REPLACE_ME_openssl_rand_base64_48
# HMAC pepper for hashing refresh/node/enrollment tokens: openssl rand -hex 32
TOKEN_HASH_PEPPER=REPLACE_ME_openssl_rand_hex_32

# Access token TTL in seconds (short-lived on purpose)
ACCESS_TOKEN_TTL_SEC=900
# Refresh token lifetime in days (rotated on every use)
REFRESH_TOKEN_TTL_DAYS=14

# --------------------------- node credentials -------------------------------
NODE_TOKEN_TTL_DAYS=30
NODE_ENROLLMENT_TOKEN_TTL_MIN=30
NODE_HEARTBEAT_INTERVAL_SEC=10
NODE_OFFLINE_AFTER_SEC=30

# --------------------------- limits / abuse ---------------------------------
MAX_DEVICES_PER_USER=3
MAX_CONCURRENT_SESSIONS=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Comma-separated list of allowed browser origins for the admin panel and
# the public site (site/ -> vpn.gluk.tech, which signs in through this API).
# The Flutter app is not a browser and is not affected by CORS.
# Example (beta): https://vpn.gluk.tech,http://localhost:8080
# Leaving this empty disables CORS entirely, so browser sign-in will fail.
CORS_ALLOWED_ORIGINS=https://api.gluk.tech

# Trust X-Forwarded-For from the local Nginx reverse proxy only.
TRUST_PROXY=127.0.0.1

# --------------------------- Oracle Cloud egress budget ---------------------
# Watches outbound traffic against the always-free 10 TB allowance and warns in
# Telegram before Oracle starts charging for it.
#
# Every value here is optional. With no credentials the background meter never
# runs, GET /api/admin/traffic-budget answers `configured: false`, and the API
# starts exactly as it does today - so this whole block can be filled in later
# without touching any code.
#
# Where to get them (Oracle Cloud console):
#   OCI_TENANCY_OCID   Profile -> Tenancy -> OCID
#   OCI_USER_OCID      Profile -> User settings -> OCID
#   OCI_FINGERPRINT    User settings -> API keys -> fingerprint of the key
#   OCI_PRIVATE_KEY_*  the private half of that API key (PEM)
#   OCI_VNIC_OCID      Instance -> Attached VNICs -> OCID
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_REGION=eu-frankfurt-1
# !! SECRET !! Prefer the path on a real host: a PEM pasted into the
# environment shows up in `systemctl show` and in every backup of this file.
# Escaped \n sequences in OCI_PRIVATE_KEY are unescaped before parsing.
OCI_PRIVATE_KEY=
OCI_PRIVATE_KEY_PATH=
OCI_PRIVATE_KEY_PASSPHRASE=
# Empty compartment = the tenancy root, where a single always-free instance
# normally lives. Empty VNIC = every VNIC in the compartment, summed.
OCI_COMPARTMENT_OCID=
OCI_VNIC_OCID=
# oci_vcn/VnicToNetworkBytes needs nothing installed on the instance.
# oci_computeagent/NetworksBytesOut needs the monitoring plugin enabled.
OCI_EGRESS_NAMESPACE=oci_vcn
OCI_EGRESS_METRIC=VnicToNetworkBytes
# Decimal terabytes, matching how Oracle quotes and bills the allowance.
OCI_EGRESS_BUDGET_TB=10
OCI_EGRESS_ALERT_TB=7,8,9,9.5
# THE DATE THE PAYG SUBSCRIPTION STARTED, e.g. 2026-03-17. The allowance resets
# on its anniversary, not on the 1st of the month. Leave this empty and the
# meter stays off, because guessing the 1st would make every alert late.
OCI_BILLING_CYCLE_START=
OCI_POLL_INTERVAL_MIN=30
OCI_TIMEOUT_MS=15000
# The $0.00 tripwire, via the Usage API. Set to false when the API key is
# scoped to Monitoring only, so a permission error does not look like a fault.
OCI_USAGE_CHECK_ENABLED=true

# --------------------------- seed (first run only) --------------------------
# Leave passwords EMPTY: the seed script generates strong random passwords and
# prints them once to stdout. Never put production passwords in this file.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_TEST_USERNAME=testuser
SEED_TEST_PASSWORD=

# --------------------------- channel / release ------------------------------
# Which deployment this process is. "prod" serves api.gluk.tech and is the only
# channel allowed to run deployments; "beta" serves beta-api.gluk.tech and
# refuses deploy/promote/rollback requests.
CHANNEL=prod
# Shown in the app (Settings -> This build) and in the admin Channels tab.
APP_VERSION=1.0.0
# Filled in automatically by deploy/bin/*.sh at release time. Leave empty here.
GIT_COMMIT=
RELEASED_AT=

# --------------------------- email (Zoho Mail) ------------------------------
# Delivery of 6-digit codes: sign-up, email change, password reset.
# Implicit TLS on 465 (SMTP_SECURE=true). Port 587 would be STARTTLS.
# src/config.ts already defaults host/port/user/from to the values below, so
# in practice only SMTP_PASSWORD has to be present for mail to start working.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@gluk.tech
SMTP_FROM=GlukVPN <noreply@gluk.tech>
# !! SECRET !! Zoho application password. Fill this in on the server only.
SMTP_PASSWORD=

# How long any code stays valid, in minutes. Five is the product rule: it
# covers sign-in codes, sign-up codes and password resets alike, so nothing
# lingers in the table or in memory waiting to be swept.
VERIFICATION_CODE_TTL_MIN=5
VERIFICATION_MAX_ATTEMPTS=5

# Open sign-up. With this off, /api/auth/register/* answers 403 and accounts
# can only be created by an admin.
SELF_REGISTRATION_ENABLED=true

# --------------------------- Telegram bot -----------------------------------
# Second half of sign-up: the bot collects a phone number through Telegram's
# own "share contact" button, which is what makes one human one account.
# !! SECRET !! Talk to @BotFather to rotate. Empty token = bot never starts.
TELEGRAM_BOT_TOKEN=
# Without the leading @. Leave empty to resolve it once through getMe.
TELEGRAM_BOT_USERNAME=
# Run the long-polling loop inside the API process. Set to false to run it as
# its own unit (`npm run bot`), so an API restart mid-deploy does not drop a
# user halfway through sharing their contact.
TELEGRAM_BOT_IN_PROCESS=true
# Which channel owns this bot token: only that one calls getUpdates.
#
# One token = one poller. When prod (:8081) and beta (:8082) both polled the
# same token, Telegram split the updates between them at random and the bot
# answered from a database that did not contain the user's code - which is
# what "Код не найден или уже истёк" / "Эта ссылка для входа неизвестна"
# actually was. Keep this at prod for the live bot; if beta needs a working
# sign-up flow, create a second bot in @BotFather, put its token in the beta
# env file and set TELEGRAM_BOT_CHANNEL=beta there.
TELEGRAM_BOT_CHANNEL=prod
# Where operational alerts go (traffic budget, unexpected Oracle charges).
# A numeric chat id, not a username - the bot can only message a chat it has
# already seen. Send /start to the bot, then read the id from the bot log.
# Empty means such an alert is logged as a warning instead of being sent.
TELEGRAM_ALERT_CHAT_ID=

# --------------------------- Telegram administration ------------------------
# Who receives registrations, purchases, warnings and the daily summary.
# Comma-separated chat ids; TELEGRAM_ALERT_CHAT_ID above is always included as
# well, so a server that only ever set that one keeps receiving everything.
TELEGRAM_ADMIN_CHAT_IDS=
# The single group the bot is allowed to work in. A negative id, e.g.
# -1001234567890: add the bot to the group, then read the chat id from the bot
# log. In any other group the bot posts a short notice and leaves at once.
TELEGRAM_ADMIN_GROUP_ID=
# Escape hatch: with this on, the bot stays in every group it is added to.
# Leave it off - and also turn "Allow Groups?" off in @BotFather, which is what
# stops an ordinary user from adding the bot to a group in the first place.
TELEGRAM_ALLOW_GROUPS=false
# The account menu in the bot: plan, traffic, devices, VPN state and buying a
# subscription. Off leaves the bot with sign-up and device codes only.
TELEGRAM_ACCOUNT_MENU_ENABLED=true
# Offset in minutes for every time the bot prints, and for the day the daily
# summary is keyed on. 300 = UTC+5 (Kazakhstan). An offset rather than an IANA
# zone, so no timezone database has to be present in the runtime.
TELEGRAM_TZ_OFFSET_MIN=300
# Local hour (0-23) the daily summary is sent at. The monitor checks about
# every ten minutes, so it arrives within ten minutes of that hour.
TELEGRAM_DIGEST_HOUR=10

# --------------------------- captcha (Cloudflare Turnstile) -----------------
# Guards sign-up and password reset only. Login is protected by per-identity
# throttling instead, so honest users are not challenged on every sign-in.
# The *site* key is public and lives in site/assets/js/config.js.
# !! SECRET !! Empty secret = verification is skipped entirely (dev checkouts).
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=true

# --------------------------- site --------------------------------------------
# Where the browser is sent for link sign-in, sign-up and password recovery.
SITE_BASE_URL=https://vpn.gluk.tech

# --------------------------- billing ----------------------------------------
# Which gateway takes the money:
#   (empty)   billing is hidden entirely; the site shows prices, not buttons
#   manual    an order is created and an admin marks it paid by hand
#   stripe    Stripe Checkout + signed webhook
#   tabpay    TabPay hosted page (SBP + cards, roubles) + signed webhook
#   mulenpay  MulenPay hosted page (cards + SBP, roubles) + fiscal receipt
#   cashera   Cashera hosted page (SBP, cards, crypto, roubles)
#
# This value is only the seed. The moment an admin picks a gateway in the
# panel (Billing -> "Payment gateway") the choice lives in the billing_settings
# row and this line is ignored. While that row does not exist - a fresh deploy,
# or a server where the migration has not run yet - the line below is what
# decides, which is why an existing installation keeps working untouched.
#
# Each of the three hosted gateways is one folder under src/payments/. Delete
# the folder and that gateway disappears from the panel and from the API, even
# if it is still named here; the others, and the rest of billing, carry on.
BILLING_PROVIDER=tabpay
# Fallback currency for a plan with no per-currency price row. The visitor's
# own currency comes from plan_prices and CF-IPCountry, not from here.
BILLING_CURRENCY=KZT
# Where the gateway returns the browser. Empty derives both from the app base
# URL below (/trial/ for a trial, /app/ otherwise, with ?paid=1 / ?failed=1 and
# the order id); set them to pin one fixed landing page for every gateway.
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
# Where those return pages live. The app is static and published separately
# (GitHub Pages), so it survives a day when the API's own domain does not -
# nothing is granted there, the page only asks the API about the order. Empty
# falls back to SITE_BASE_URL.
BILLING_APP_BASE_URL=https://app.gluk.tech
# Shown after a "manual" order is created. {orderId} and {amount} substituted.
BILLING_MANUAL_INSTRUCTIONS=
# !! SECRETS !! Stripe only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --------------------------- gateway: TabPay --------------------------------
# Card data never touches this server, and that is true of all three gateways:
# the customer is redirected to the gateway's own payment page and the plan is
# handed out by the webhook, never by the redirect back. A sandbox shop speaks
# the same API as a live one, so going live is these three values and nothing
# else. Keys are read by src/payments/tabpay/ and by nothing outside it.
#
# In the TabPay dashboard set:
#   Webhook URL   https://api.gluk.tech/api/billing/webhook/tabpay
#   Success URL   https://app.gluk.tech/trial/?paid=1
#   Failure URL   https://app.gluk.tech/trial/?failed=1
# (beta uses https://beta-api.gluk.tech/... for the webhook)
TABPAY_API_BASE=https://tabpay.org
# !! SECRETS !! The API key authenticates us to the shop; the signing secret is
# what proves an incoming webhook is really TabPay's.
TABPAY_API_KEY=
TABPAY_WEBHOOK_SECRET=
# Informational: the key already identifies the shop, but keeping the id here
# makes a sandbox/live mismatch obvious in one glance.
TABPAY_SHOP_ID=
# Pin one method ("SBP" or "CARD"); empty lets the payer choose on the page.
TABPAY_METHOD=
TABPAY_TIMEOUT_MS=15000

# --------------------------- gateway: MulenPay ------------------------------
# Roubles, cards and SBP, with a 54-FZ receipt issued for every payment.
#
# In the MulenPay dashboard set:
#   Webhook URL   https://api.gluk.tech/api/billing/webhook/mulenpay
#                 (append ?token=<MULENPAY_WEBHOOK_TOKEN> if you set one)
#   Success URL   https://app.gluk.tech/trial/?paid=1
#   Failure URL   https://app.gluk.tech/trial/?failed=1
# The callback is per shop, not per payment, so it is typed in once by hand.
#
# Unlike TabPay, MulenPay does not sign its callbacks. A delivery is therefore
# treated as a hint: the status is re-read from GET /payments/{id} and the plan
# is granted only if MulenPay itself reports status 3. The token below is a
# lock on the letterbox, not a signature.
MULENPAY_API_BASE=https://api.mulenpay.com/api/v3
# !! SECRETS !! The API key goes out as the Authorization header; the secret
# key never leaves the server - it is only hashed into the payment signature.
# Both live next to the shop id in the MulenPay dashboard.
MULENPAY_API_KEY=
MULENPAY_SECRET_KEY=
# Part of the signature, so it has to match the shop the keys belong to.
MULENPAY_SHOP_ID=
# !! SECRET !! Optional, any random string; must match the ?token= above.
# Empty accepts every delivery, which is fine only because of the re-read.
MULENPAY_WEBHOOK_TOKEN=
# Receipt and form details an accountant may want to change without a deploy:
# language of the hosted page, VAT code (0 = none), payment subject (4 =
# service) and payment mode (4 = paid in full).
MULENPAY_LANGUAGE=ru
MULENPAY_VAT_CODE=0
MULENPAY_PAYMENT_SUBJECT=4
MULENPAY_PAYMENT_MODE=4
MULENPAY_TIMEOUT_MS=15000

# --------------------------- gateway: Cashera -------------------------------
# Roubles over SBP, cards or crypto. The callback address is sent with every
# transaction, so the dashboard entry is only a fallback.
#
# In the Cashera dashboard set:
#   Webhook URL   https://api.gluk.tech/api/billing/webhook/cashera
#   Success URL   https://app.gluk.tech/trial/?paid=1
#   Failure URL   https://app.gluk.tech/trial/?failed=1
CASHERA_API_BASE=https://api.cashera.cash/api/v1
# !! SECRETS !! Two different keys, and the difference matters: the pk_ key
# authenticates our calls (X-Api-Key), while the sk_ secret only ever arrives -
# in X-Secret, compared in constant time - and is what proves a delivery is
# genuine. The sk_ value is issued in the merchant dashboard, not by the API.
CASHERA_API_KEY=
CASHERA_WEBHOOK_SECRET=
# Informational, like the other shop ids: the key identifies the merchant.
CASHERA_MERCHANT_ID=
# Pin one rail - sbp, card, mastercard, crypto or cryptobot - or leave empty to
# let the payer choose. An unknown value is ignored rather than passed through.
CASHERA_PAYMENT_METHOD=
# Smallest charge this shop will send, in kopecks. The card rail has a 100 ₽
# floor while SBP and crypto start at a kopeck, so the default follows the
# pinned method (10000 for cards, 1 otherwise) and a 1 ₽ trial needs SBP.
# Set this only to raise the floor by hand.
CASHERA_MIN_MINOR=
CASHERA_TIMEOUT_MS=15000

# --------------------------- trial offer ------------------------------------
# Seed values for the "Basic for 1 ₽" promotion. They only fill the row the
# first time it is read; after that the admin panel owns it, so changing the
# plan, the length or the window - or switching the offer off - is a click and
# not a deploy.
TRIAL_OFFER_ENABLED=true
# Which plan the trial previews: basic or pro.
TRIAL_OFFER_PLAN=basic
TRIAL_OFFER_DAYS=7
# How long after sign-up an account may still claim it.
TRIAL_OFFER_WINDOW_DAYS=14
# The token charge in kopecks. 100 = 1 ₽, which is also the floor of every
# rouble gateway here: the point of the exercise is a card that can actually be
# charged once. On Cashera pair it with CASHERA_PAYMENT_METHOD=sbp, because the
# card rail refuses anything under 100 ₽.
TRIAL_OFFER_PRICE_KOPECKS=100
# A Telegram-verified account is the cheapest proof that a sign-up is a person.
TRIAL_OFFER_REQUIRE_TELEGRAM=true

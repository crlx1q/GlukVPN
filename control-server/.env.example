# ============================================================================
# GlukVPN control server — environment template
# Copy to .env on the server ONLY:  cp .env.example .env && chmod 600 .env
# .env is git-ignored. Never commit real values.
# ============================================================================

NODE_ENV=production
# Bind to loopback only: aaPanel Nginx terminates TLS and proxies to this port.
HOST=127.0.0.1
PORT=8081
LOG_LEVEL=info

# Public HTTPS base URL (used by the node agent and the Flutter client)
PUBLIC_API_URL=https://api.gluk.tech

# --------------------------- database ---------------------------------------
# PostgreSQL listens on 127.0.0.1 only. Generate the password with:
#   openssl rand -base64 24
DATABASE_URL=postgresql://glukvpn:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:5432/glukvpn?schema=public

# --------------------------- crypto secrets ---------------------------------
# JWT signing secret:            openssl rand -base64 48
JWT_SECRET=REPLACE_ME_openssl_rand_base64_48
# HMAC pepper for hashing refresh/node/enrollment tokens: openssl rand -hex 32
TOKEN_HASH_PEPPER=REPLACE_ME_openssl_rand_hex_32

# Access token TTL in seconds (short-lived on purpose)
ACCESS_TOKEN_TTL_SEC=900
# Refresh token lifetime in days (rotated on every use)
REFRESH_TOKEN_TTL_DAYS=14

# --------------------------- node credentials -------------------------------
NODE_TOKEN_TTL_DAYS=30
NODE_ENROLLMENT_TOKEN_TTL_MIN=30
NODE_HEARTBEAT_INTERVAL_SEC=10
NODE_OFFLINE_AFTER_SEC=30

# --------------------------- limits / abuse ---------------------------------
MAX_DEVICES_PER_USER=3
MAX_CONCURRENT_SESSIONS=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Comma-separated list of allowed browser origins for the admin panel and
# the public site (site/ -> vpn.gluk.tech, which signs in through this API).
# The Flutter app is not a browser and is not affected by CORS.
# Example (beta): https://vpn.gluk.tech,http://localhost:8080
# Leaving this empty disables CORS entirely, so browser sign-in will fail.
CORS_ALLOWED_ORIGINS=https://api.gluk.tech

# Trust X-Forwarded-For from the local Nginx reverse proxy only.
TRUST_PROXY=127.0.0.1

# --------------------------- Oracle Cloud egress budget ---------------------
# Watches outbound traffic against the always-free 10 TB allowance and warns in
# Telegram before Oracle starts charging for it.
#
# Every value here is optional. With no credentials the background meter never
# runs, GET /api/admin/traffic-budget answers `configured: false`, and the API
# starts exactly as it does today - so this whole block can be filled in later
# without touching any code.
#
# Where to get them (Oracle Cloud console):
#   OCI_TENANCY_OCID   Profile -> Tenancy -> OCID
#   OCI_USER_OCID      Profile -> User settings -> OCID
#   OCI_FINGERPRINT    User settings -> API keys -> fingerprint of the key
#   OCI_PRIVATE_KEY_*  the private half of that API key (PEM)
#   OCI_VNIC_OCID      Instance -> Attached VNICs -> OCID
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_REGION=eu-frankfurt-1
# !! SECRET !! Prefer the path on a real host: a PEM pasted into the
# environment shows up in `systemctl show` and in every backup of this file.
# Escaped \n sequences in OCI_PRIVATE_KEY are unescaped before parsing.
OCI_PRIVATE_KEY=
OCI_PRIVATE_KEY_PATH=
OCI_PRIVATE_KEY_PASSPHRASE=
# Empty compartment = the tenancy root, where a single always-free instance
# normally lives. Empty VNIC = every VNIC in the compartment, summed.
OCI_COMPARTMENT_OCID=
OCI_VNIC_OCID=
# oci_vcn/VnicToNetworkBytes needs nothing installed on the instance.
# oci_computeagent/NetworksBytesOut needs the monitoring plugin enabled.
OCI_EGRESS_NAMESPACE=oci_vcn
OCI_EGRESS_METRIC=VnicToNetworkBytes
# Decimal terabytes, matching how Oracle quotes and bills the allowance.
OCI_EGRESS_BUDGET_TB=10
OCI_EGRESS_ALERT_TB=7,8,9,9.5
# THE DATE THE PAYG SUBSCRIPTION STARTED, e.g. 2026-03-17. The allowance resets
# on its anniversary, not on the 1st of the month. Leave this empty and the
# meter stays off, because guessing the 1st would make every alert late.
OCI_BILLING_CYCLE_START=
OCI_POLL_INTERVAL_MIN=30
OCI_TIMEOUT_MS=15000
# The $0.00 tripwire, via the Usage API. Set to false when the API key is
# scoped to Monitoring only, so a permission error does not look like a fault.
OCI_USAGE_CHECK_ENABLED=true

# --------------------------- seed (first run only) --------------------------
# Leave passwords EMPTY: the seed script generates strong random passwords and
# prints them once to stdout. Never put production passwords in this file.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_TEST_USERNAME=testuser
SEED_TEST_PASSWORD=

# --------------------------- channel / release ------------------------------
# Which deployment this process is. "prod" serves api.gluk.tech and is the only
# channel allowed to run deployments; "beta" serves beta-api.gluk.tech and
# refuses deploy/promote/rollback requests.
CHANNEL=prod
# Shown in the app (Settings -> This build) and in the admin Channels tab.
APP_VERSION=1.0.0
# Filled in automatically by deploy/bin/*.sh at release time. Leave empty here.
GIT_COMMIT=
RELEASED_AT=

# --------------------------- email (Zoho Mail) ------------------------------
# Delivery of 6-digit codes: sign-up, email change, password reset.
# Implicit TLS on 465 (SMTP_SECURE=true). Port 587 would be STARTTLS.
# src/config.ts already defaults host/port/user/from to the values below, so
# in practice only SMTP_PASSWORD has to be present for mail to start working.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@gluk.tech
SMTP_FROM=GlukVPN <noreply@gluk.tech>
# !! SECRET !! Zoho application password. Fill this in on the server only.
SMTP_PASSWORD=

# How long any code stays valid, in minutes. Five is the product rule: it
# covers sign-in codes, sign-up codes and password resets alike, so nothing
# lingers in the table or in memory waiting to be swept.
VERIFICATION_CODE_TTL_MIN=5
VERIFICATION_MAX_ATTEMPTS=5

# Open sign-up. With this off, /api/auth/register/* answers 403 and accounts
# can only be created by an admin.
SELF_REGISTRATION_ENABLED=true

# --------------------------- Telegram bot -----------------------------------
# Second half of sign-up: the bot collects a phone number through Telegram's
# own "share contact" button, which is what makes one human one account.
# !! SECRET !! Talk to @BotFather to rotate. Empty token = bot never starts.
TELEGRAM_BOT_TOKEN=
# Without the leading @. Leave empty to resolve it once through getMe.
TELEGRAM_BOT_USERNAME=
# Run the long-polling loop inside the API process. Set to false to run it as
# its own unit (`npm run bot`), so an API restart mid-deploy does not drop a
# user halfway through sharing their contact.
TELEGRAM_BOT_IN_PROCESS=true
# Where operational alerts go (traffic budget, unexpected Oracle charges).
# A numeric chat id, not a username - the bot can only message a chat it has
# already seen. Send /start to the bot, then read the id from the bot log.
# Empty means such an alert is logged as a warning instead of being sent.
TELEGRAM_ALERT_CHAT_ID=

# --------------------------- captcha (Cloudflare Turnstile) -----------------
# Guards sign-up and password reset only. Login is protected by per-identity
# throttling instead, so honest users are not challenged on every sign-in.
# The *site* key is public and lives in site/assets/js/config.js.
# !! SECRET !! Empty secret = verification is skipped entirely (dev checkouts).
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=true

# --------------------------- site --------------------------------------------
# Where the browser is sent for link sign-in, sign-up and password recovery.
SITE_BASE_URL=https://vpn.gluk.tech

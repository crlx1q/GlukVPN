// ============================================================================
// GlukVPN — control plane schema (PostgreSQL, managed by Prisma Migrate)
// Never store: client WireGuard private keys, raw tokens, raw node secrets.
// Tokens/secrets are stored only as HMAC-SHA256 hashes (peppered).
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  // linux-arm64-openssl-3.0.x is required for Ubuntu 24.04 ARM64 (Oracle Cloud)
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- enums ---------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
  /// Blocked by an administrator for abuse. Same effect as DISABLED (no login,
  /// no tunnels, tokens revoked) but kept apart so support can tell "switched
  /// off" from "banned", and so the block reason has somewhere to live.
  BLOCKED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum NodeStatus {
  PENDING
  ONLINE
  OFFLINE
  DISABLED
}

enum SessionStatus {
  PENDING
  ACTIVE
  CLOSED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

enum CommandType {
  ADD_PEER
  REMOVE_PEER
  SYNC_PEERS
  /// Re-read the sing-box policy (VLESS users + block rules) right now instead
  /// of waiting for the next heartbeat to notice the version changed.
  SYNC_POLICY
}

/// What one sing-box route rule matches on. Values map 1:1 onto sing-box
/// route-rule fields, and the agent turns every enabled row into
/// `{ <field>: [value], "action": "reject" }` - nothing else is ever generated
/// from this table, so a rule can block traffic but can never redirect it.
enum BlockRuleKind {
  /// Sniffed application protocol: bittorrent, quic, stun, dns, ssh, rdp, ...
  PROTOCOL
  /// Exact domain ("tracker.example.org").
  DOMAIN
  /// Domain suffix (".example.org" matches every subdomain).
  DOMAIN_SUFFIX
  /// Substring anywhere in the domain ("torrent").
  DOMAIN_KEYWORD
  /// Go regular expression over the domain.
  DOMAIN_REGEX
  /// Destination IP or CIDR ("203.0.113.0/24").
  IP_CIDR
  /// Destination port ("25").
  PORT
  /// Destination port range ("6881:6999").
  PORT_RANGE
}

enum LinkRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  USED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum CommandStatus {
  PENDING
  DELIVERED
  DONE
  FAILED
}

/// Fixed, parameterless deployment scenarios. The worker maps each value to one
/// hard-coded script; nothing from this table is ever passed to a shell. That
/// is what keeps the admin "Promote" button from being remote code execution.
enum DeployAction {
  DEPLOY_BETA
  PROMOTE_BETA_TO_PROD
  ROLLBACK_PROD
  // Lifecycle of the beta stack only (control server + node agent + wg1).
  // There is deliberately no equivalent for prod: prod is never stopped from
  // a web button.
  START_BETA
  STOP_BETA
  RESTART_BETA
}

enum DeployJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

// ----------------------------- users ---------------------------------------

model User {
  id              String     @id @default(uuid()) @db.Uuid
  /// Public, immutable account number: 8 digits that always start with 1
  /// ("10758930"). Random, so it leaks neither signup order nor user count and
  /// cannot be enumerated. A DB trigger rejects every change to it.
  /// `username` and `email` are renameable — this is not. Search and ban by it.
  publicId        String     @unique @map("public_id") @default(dbgenerated("gen_user_public_id()"))
  username        String     @unique
  /// Second login identity. Stored lower-cased; login accepts username OR
  /// email. A new address only replaces the old one once it is confirmed.
  email           String?    @unique
  emailVerifiedAt DateTime?  @map("email_verified_at")
  /// Telegram is the second step of the signup funnel, not a login method.
  /// The bot only ever learns the numeric id, the @handle and - once the user
  /// presses "Share contact" - the phone number. The phone is what makes one
  /// human one account, which is the whole reason this step exists.
  telegramId         String?   @unique @map("telegram_id")
  telegramUsername   String?   @map("telegram_username")
  telegramPhone      String?   @unique @map("telegram_phone")
  telegramVerifiedAt DateTime? @map("telegram_verified_at")
  passwordHash    String     @map("password_hash")
  status          UserStatus @default(ACTIVE)
  isAdmin         Boolean    @default(false) @map("is_admin")
  /// Beta tester: may switch the PROD/BETA channel in every client without
  /// being an administrator. Set from the admin panel.
  isTester        Boolean    @default(false) @map("is_tester")
  blockedAt       DateTime?  @map("blocked_at")
  blockedReason   String?    @map("blocked_reason")
  maxDevices      Int        @default(3) @map("max_devices")
  maxSessions     Int        @default(1) @map("max_concurrent_sessions")
  /// Approximate origin resolved from the login IP: country/region only.
  /// Never GPS coordinates — the map marker is drawn from the country centre.
  lastCountry     String?    @map("last_country")
  lastCountryCode String?    @map("last_country_code")
  lastRegion      String?    @map("last_region")
  geoUpdatedAt    DateTime?  @map("geo_updated_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  devices           Device[]
  sessions          Session[]
  subscriptions     Subscription[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  deployJobs        DeployJob[]
  verificationCodes VerificationCode[]
  identityLinks     IdentityLink[]
  linkRequests      LinkRequest[]
  blockRules        NodeBlockRule[]
  domainStats       TrafficDomainStat[]
  orders            Order[]

  @@map("users")
}

model Device {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  deviceName String       @map("device_name")
  // WireGuard public key of the device. The private key never leaves the phone.
  publicKey  String       @unique @map("public_key")
  /// Personal VLESS credential for the sing-box gateway. One per device, issued
  /// at registration, never shared: it is what lets a node attribute traffic to
  /// exactly this device and what gets cut when the device is revoked. The
  /// fleet-wide VLESS_UUID from .env is only a fallback for rows that predate
  /// this column.
  vlessUuid  String?      @unique @map("vless_uuid") @db.Uuid
  platform   String?
  status     DeviceStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  lastSeen   DateTime?    @map("last_seen")
  revokedAt  DateTime?    @map("revoked_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      Session[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  domainStats   TrafficDomainStat[]

  @@index([userId])
  @@index([status])
  @@map("devices")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceId     String?   @map("device_id") @db.Uuid
  // HMAC-SHA256(pepper, raw token) — raw token exists only on the device
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  device     Device?       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id])
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([deviceId])
  @@map("refresh_tokens")
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  username  String
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([username, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// ----------------------------- nodes ---------------------------------------

model VpnNode {
  id                 String     @id @default(uuid()) @db.Uuid
  /// Internal handle ("de-01"). Admin/debug only — never shown in the app.
  name               String     @unique
  /// User-facing geography. The app renders "Germany · Frankfurt" from these.
  country            String
  countryCode        String     @map("country_code")
  region             String?
  city               String?
  /// Host or IP the client measures latency against. Falls back to the
  /// tunnel gateway when empty.
  pingTarget         String?    @map("ping_target")
  hostname           String
  publicIp           String     @map("public_ip")
  wireguardPublicKey String?    @map("wireguard_public_key")
  wireguardPort      Int        @default(51820) @map("wireguard_port")
  subnetCidr         String     @default("10.8.0.0/24") @map("subnet_cidr")
  dns                String     @default("1.1.1.1,1.0.0.1")
  mtu                Int        @default(1420)
  status             NodeStatus @default(PENDING)
  /// Minimum subscription tier that may connect here (0 = everyone).
  tier               Int        @default(0)
  capacity           Int        @default(50)
  activePeers        Int        @default(0) @map("active_peers")
  cpuPercent         Float?     @map("cpu_percent")
  ramPercent         Float?     @map("ram_percent")
  uptimeSeconds      Int?       @map("uptime_seconds")
  agentVersion       String?    @map("agent_version")
  lastHeartbeat      DateTime?  @map("last_heartbeat")

  /// sing-box VLESS-over-TLS gateway on this node, as reported by the agent in
  /// its heartbeat. Null host = the node has no gateway and clients use
  /// WireGuard. Per-node on purpose: the .env VLESS_* values were one gateway
  /// for the whole fleet, which stops being true with the second node.
  gatewayHost        String?    @map("gateway_host")
  gatewayPort        Int?       @map("gateway_port")
  gatewaySni         String?    @map("gateway_sni")
  gatewayFlow        String?    @map("gateway_flow")
  gatewayUpdatedAt   DateTime?  @map("gateway_updated_at")
  /// Policy version (users + block rules) the agent last confirmed it applied.
  policyVersion      String?    @map("policy_version")
  policyAppliedAt    DateTime?  @map("policy_applied_at")

  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  tokens      NodeToken[]
  sessions    Session[]
  commands    NodeCommand[]
  ipLeases    IpLease[]
  auditLogs   AuditLog[]
  blockRules  NodeBlockRule[]
  domainStats TrafficDomainStat[]

  @@index([status])
  @@map("vpn_nodes")
}

/// One "reject" rule for the sing-box router on a node (or on every node when
/// `nodeId` is null). Built-in rules (BitTorrent, outbound SMTP) are not rows:
/// the agent always emits them, so they cannot be switched off by mistake.
model NodeBlockRule {
  id          String        @id @default(uuid()) @db.Uuid
  /// Null = applies to all nodes.
  nodeId      String?       @map("node_id") @db.Uuid
  kind        BlockRuleKind
  value       String
  /// "tcp", "udp" or null for both.
  network     String?
  enabled     Boolean       @default(true)
  note        String?
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  node      VpnNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([nodeId, enabled])
  @@map("node_block_rules")
}

/// Which sites a device talked to through a node, aggregated per session and
/// domain. Fed by the sing-box sniffer (SNI / HTTP host / QUIC) via the node
/// agent. Only the host name and byte counters are kept - never URLs, never
/// payloads - and rows are purged after DOMAIN_STATS_RETENTION_DAYS.
model TrafficDomainStat {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  deviceId    String   @map("device_id") @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  nodeId      String   @map("node_id") @db.Uuid
  domain      String
  category    String?
  bytesRx     BigInt   @default(0) @map("bytes_rx")
  bytesTx     BigInt   @default(0) @map("bytes_tx")
  connections Int      @default(0)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device  Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  node    VpnNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([sessionId, domain])
  @@index([userId, lastSeenAt])
  @@index([deviceId, lastSeenAt])
  @@index([lastSeenAt])
  @@map("traffic_domain_stats")
}

/// One-time enrollment token: lets a fresh node exchange it for its own node token.
model NodeEnrollmentToken {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  note         String?
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  usedByNodeId String?   @map("used_by_node_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("node_enrollment_tokens")
}

/// Per-node credential. Supports rotation, revoke and expiration.
model NodeToken {
  id         String    @id @default(uuid()) @db.Uuid
  nodeId     String    @map("node_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  label      String?
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  node VpnNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@map("node_tokens")
}

/// Command queue consumed by the node agent over HTTPS (pull model, no inbound port).
model NodeCommand {
  id          String        @id @default(uuid()) @db.Uuid
  nodeId      String        @map("node_id") @db.Uuid
  sessionId   String?       @map("session_id") @db.Uuid
  type        CommandType
  status      CommandStatus @default(PENDING)
  payload     Json          @db.JsonB
  result      Json?         @db.JsonB
  attempts    Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")
  deliveredAt DateTime?     @map("delivered_at")
  completedAt DateTime?     @map("completed_at")

  node    VpnNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([nodeId, status])
  @@map("node_commands")
}

/// VPN IP address pool allocation, one row per usable address per node.
model IpLease {
  id          String    @id @default(uuid()) @db.Uuid
  nodeId      String    @map("node_id") @db.Uuid
  ip          String
  sessionId   String?   @unique @map("session_id") @db.Uuid
  allocatedAt DateTime? @map("allocated_at")

  node    VpnNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([nodeId, ip])
  @@index([nodeId, sessionId])
  @@map("ip_leases")
}

// --------------------------- sessions --------------------------------------

model Session {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  deviceId        String        @map("device_id") @db.Uuid
  nodeId          String        @map("node_id") @db.Uuid
  assignedVpnIp   String        @map("assigned_vpn_ip")
  peerPublicKey   String        @map("peer_public_key")
  status          SessionStatus @default(PENDING)
  connectedAt     DateTime      @default(now()) @map("connected_at")
  disconnectedAt  DateTime?     @map("disconnected_at")
  /// WireGuard: time of the last handshake. VLESS: time of the last observed
  /// connection - there is no handshake, so this reads as "last activity".
  lastHandshakeAt DateTime?     @map("last_handshake_at")
  // Byte counters only — no traffic content, no URLs, no DPI.
  bytesRx         BigInt        @default(0) @map("bytes_rx")
  bytesTx         BigInt        @default(0) @map("bytes_tx")
  closeReason     String?       @map("close_reason")
  /// "wireguard" until the node reports VLESS traffic for this device, then
  /// "vless". Inferred, never claimed by the client.
  transport       String        @default("wireguard")
  /// Public IP the connect request came from (abuse handling; not shown to users).
  clientIp        String?       @map("client_ip")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  device      Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  node        VpnNode             @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  commands    NodeCommand[]
  ipLease     IpLease?
  domainStats TrafficDomainStat[]

  @@index([userId, status])
  @@index([nodeId, status])
  @@index([deviceId, status])
  @@map("sessions")
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  /// Plan code: "free", "basic", "pro" (see `plans`), or the legacy "test".
  plan      String             @default("test")
  /// Entitlement level copied from the plan at purchase time. Nodes carry a
  /// minimum tier; a session is only opened when the subscription meets it.
  tier      Int                @default(0)
  /// "manual" (admin/CLI), "order" (paid through billing), "seed", "promo".
  source    String             @default("manual")
  status    SubscriptionStatus @default(ACTIVE)
  expiresAt DateTime           @map("expires_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("subscriptions")
}

// ------------------------------ billing ------------------------------------

/// A sellable plan. Prices are minor units (tiyn / cents) to avoid floats.
model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  tier        Int      @default(0)
  days        Int      @default(30)
  priceMinor  Int      @default(0) @map("price_minor")
  currency    String   @default("KZT")
  maxDevices  Int      @default(3) @map("max_devices")
  maxSessions Int      @default(1) @map("max_sessions")
  features    Json     @default("[]") @db.JsonB
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("plans")
}

/// One purchase attempt. `provider` names the gateway adapter ("manual",
/// "stripe", ...); `providerRef` is its id for the payment so a webhook can
/// find the order. A PAID order extends the user's subscription exactly once.
model Order {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  planId      String      @map("plan_id") @db.Uuid
  status      OrderStatus @default(PENDING)
  amountMinor Int         @map("amount_minor")
  currency    String
  provider    String
  providerRef String?     @map("provider_ref")
  paymentUrl  String?     @map("payment_url")
  paidAt      DateTime?   @map("paid_at")
  metadata    Json?       @db.JsonB
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status])
  @@index([providerRef])
  @@map("orders")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  deviceId  String?  @map("device_id") @db.Uuid
  nodeId    String?  @map("node_id") @db.Uuid
  action    String
  ip        String?
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  user   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  device Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  node   VpnNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// --------------------------- deployments -----------------------------------

/// Queue between the admin panel and the local deploy worker.
///
/// The panel only inserts a row with one of three fixed actions. The worker
/// picks it up, runs the matching script and writes back the outcome. No shell
/// string, path or argument ever crosses this table, so a compromised database
/// can at worst trigger a normal deployment - never arbitrary commands.
model DeployJob {
  id                String          @id @default(uuid()) @db.Uuid
  action            DeployAction
  status            DeployJobStatus @default(QUEUED)
  requestedById     String?         @map("requested_by_id") @db.Uuid
  /// Release directory activated by this job (worker-generated timestamp).
  releaseId         String?         @map("release_id")
  /// Release that was live before, i.e. the rollback target.
  previousReleaseId String?         @map("previous_release_id")
  /// Path of the pg_dump taken before a promote.
  backupPath        String?         @map("backup_path")
  exitCode          Int?            @map("exit_code")
  /// Trimmed script output. Scripts are written to never echo secrets.
  log               String?
  createdAt         DateTime        @default(now()) @map("created_at")
  startedAt         DateTime?       @map("started_at")
  finishedAt        DateTime?       @map("finished_at")

  requestedBy User? @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("deploy_jobs")
}

// -------------------- identity, verification & social ----------------------

/// Short-lived confirmation code: email verification, email change, password
/// reset, self-registration and new-device confirmation, over email today and
/// Telegram later. Only the HMAC of the code is stored, so a database dump
/// cannot be replayed — same rule as refresh and node tokens.
model VerificationCode {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String?             @map("user_id") @db.Uuid
  purpose     VerificationPurpose
  channel     VerificationChannel @default(EMAIL)
  /// Target address or handle. For EMAIL_CHANGE this is the *new* address,
  /// which is why the change can only land after the code is consumed.
  destination String
  codeHash    String              @map("code_hash")
  attempts    Int                 @default(0)
  expiresAt   DateTime            @map("expires_at")
  consumedAt  DateTime?           @map("consumed_at")
  createdIp   String?             @map("created_ip")
  createdAt   DateTime            @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([purpose, destination])
  @@index([userId])
  @@index([expiresAt])
  @@map("verification_codes")
}

/// A signup that has not become an account yet.
///
/// The funnel is email -> 6-digit code -> Telegram contact, and a row only
/// turns into a `User` when all three are done. Keeping it out of `users` is
/// what stops an abandoned signup from occupying a username, from ever being
/// able to sign in, and from lingering as a half-account: the sweeper simply
/// deletes it. It also means the uniqueness rules on `users` keep meaning
/// "real accounts", not "real accounts and everyone who once typed an email".
model PendingRegistration {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  /// Argon2id, exactly like `users.password_hash`. A pending row holds a real
  /// credential from the first request, so it gets real credential storage.
  passwordHash       String    @map("password_hash")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  /// The token the user hands to the bot as `/start <code>`. Stored in the
  /// clear on purpose: on its own it authorises nothing, it only tells the bot
  /// which pending row a chat belongs to. The account still cannot exist until
  /// that chat shares a phone number.
  telegramCode       String    @unique @map("telegram_code")
  telegramId         String?   @map("telegram_id")
  telegramUsername   String?   @map("telegram_username")
  telegramPhone      String?   @map("telegram_phone")
  telegramVerifiedAt DateTime? @map("telegram_verified_at")
  /// Google signup skips the email code but still has to pass Telegram.
  googleSub          String?   @map("google_sub")
  createdIp          String?   @map("created_ip")
  expiresAt          DateTime  @map("expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@index([telegramId])
  @@map("pending_registrations")
}

/// Google / Telegram account link. Stays empty until those sign-in flows are
/// switched on; it exists now so they never have to alter the users table.
model IdentityLink {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  provider       IdentityProvider
  providerUserId String           @map("provider_user_id")
  providerEmail  String?          @map("provider_email")
  providerName   String?          @map("provider_name")
  providerPhone  String?          @map("provider_phone")
  createdAt      DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("identity_links")
}

/// Sign-in by link (device-authorization grant) for the desktop client, the
/// extension and the website. Persisted so a request survives an API restart
/// and so prod and beta each keep their own table rather than their own RAM.
/// No token is ever stored here: approval only records *who* approved, and the
/// tokens are minted at the moment the client collects them.
model LinkRequest {
  id             String            @id @default(uuid()) @db.Uuid
  userCode       String            @unique @map("user_code")
  pollSecretHash String            @map("poll_secret_hash")
  client         String
  deviceName     String?           @map("device_name")
  ip             String?
  userAgent      String?           @map("user_agent")
  status         LinkRequestStatus @default(PENDING)
  userId         String?           @map("user_id") @db.Uuid
  /// "web" or "telegram" - which surface approved it.
  approvedVia    String?           @map("approved_via")
  expiresAt      DateTime          @map("expires_at")
  lastPollAt     DateTime?         @map("last_poll_at")
  approvedAt     DateTime?         @map("approved_at")
  usedAt         DateTime?         @map("used_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("link_requests")
}

enum VerificationPurpose {
  EMAIL_VERIFY
  EMAIL_CHANGE
  PASSWORD_RESET
  REGISTRATION
  DEVICE_CONFIRM
  /// Re-binding Telegram on an existing account (Settings -> Account).
  TELEGRAM_LINK
}

enum VerificationChannel {
  EMAIL
  TELEGRAM
}

enum IdentityProvider {
  GOOGLE
  TELEGRAM
}
